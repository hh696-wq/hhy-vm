#!/usr/bin/env hhy

import { crawl, records, failures } from "./lib/engine.hhy"

if length(args) != 4 {
    print_error("usage: hhy run crawler.hhy <config.json> <records.json> <report.json> <failures.json>")
    exit(3)
}
try {
    let config = read_text(path(args[0])) |> parse_json
    let result = crawl(config)
    let items = records(result)
    let failed = failures(result)
    let successful_pages = result.pages |> stream |> where { page -> page.ok == true } |> count
    let report = {
        tool: "HHY Collector Framework",
        version: "2.0.0",
        project: config.project,
        ok: length(failed) == 0,
        stats: {
            seed_pages: length(config.seeds),
            requested_pages: length(result.pages),
            successful_pages: successful_pages,
            failed_pages: length(failed),
            records: length(items),
            discovered_urls: result.stats.discovered_urls,
            unique_fingerprints: result.stats.unique_fingerprints,
            duplicate_urls: result.stats.duplicate_urls,
            rejected_urls: result.stats.rejected_urls,
            limited_urls: result.stats.limited_urls,
            max_depth_reached: result.stats.max_depth_reached
            , resumed: result.stats.resumed
            , completed: result.stats.completed
        }
    }

    items |> encode_json({ pretty: true }) |> save_text(path(args[1]), { atomic: true, create_parents: true })
    report |> encode_json({ pretty: true }) |> save_text(path(args[2]), { atomic: true, create_parents: true })
    failed |> encode_json({ pretty: true }) |> save_text(path(args[3]), { atomic: true, create_parents: true })

    print("HHY Collector Framework", config.project)
    print("Pages", successful_pages, "/", length(result.pages), "Records", length(items), "Failures", length(failed))
    print("Records", path(args[1]))
    print("Report", path(args[2]))
    print("Failures", path(args[3]))
    if not report.ok { exit(1) }
} catch err {
    print_error(err)
    exit(1)
}
