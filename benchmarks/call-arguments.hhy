# Synthetic call-layout stress; not evidence of real-workload admission.
fn weighted(a, b, c, d, e, f, g, h) {
    return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8
}
let mut total = 0
for item in range(0, 100000) {
    total = total + weighted(item, 2, 3, 4, 5, 6, 7, 8)
}
print(total)
