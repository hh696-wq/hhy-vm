#!/usr/bin/env hhy

import database
import { load_database_config } from "./lib/config.hhy"

if length(args) != 1 {
    print_error("usage: hhy run create-test-database.hhy <database-config.json>")
    exit(3)
}

let config = load_database_config(args[0])
database.execute(
    config.url,
    "CREATE DATABASE IF NOT EXISTS hhy_extension_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci",
    []
) |> print
