#!/usr/bin/env hhy

import database
import { load_database_config } from "./lib/config.hhy"

if length(args) != 2 or args[1] != "--write" {
    print_error("usage: hhy run write-demo.hhy <config.json> --write")
    print_error("this creates and removes the dedicated table _hhy_database_example")
    exit(3)
}

try {
    let config = load_database_config(args[0])

    if config.database != "hhy_extension_test" {
        print_error("write demo only permits the hhy_extension_test database")
        exit(3)
    }

    database.execute(
        config.url,
        "CREATE TABLE IF NOT EXISTS _hhy_database_example (id BIGINT PRIMARY KEY, message VARCHAR(255) NOT NULL)",
        []
    ) |> print

    database.execute(
        config.url,
        "INSERT INTO _hhy_database_example (id, message) VALUES (?, ?)",
        [1, "created by HHY"]
    ) |> print

    database.query(
        config.url,
        "SELECT id, message FROM _hhy_database_example WHERE id = ?",
        [1],
        1
    ) |> get("rows") |> print

    database.execute(
        config.url,
        "UPDATE _hhy_database_example SET message = ? WHERE id = ?",
        ["updated by HHY", 1]
    ) |> print

    database.query(
        config.url,
        "SELECT id, message FROM _hhy_database_example WHERE id = ?",
        [1],
        1
    ) |> get("rows") |> print

    database.execute(
        config.url,
        "DELETE FROM _hhy_database_example WHERE id = ?",
        [1]
    ) |> print

    database.execute(
        config.url,
        "DROP TABLE _hhy_database_example",
        []
    ) |> print
} catch err {
    print_error(err)
    exit(1)
}
