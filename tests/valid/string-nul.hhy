let value = parse_json("\"a\\u0000b\"")
let literal_nul = "a\0b"
print(literal_nul == value)
print(length(value))
print(byte_length(value))
print(encode_json(value))
print(encode_json(value[1]))
print(value == parse_json("\"a\\u0000b\""))
let nul = value[1]
print(contains(value, nul))
print(encode_json(split(value, nul)))
print(encode_json(join(["a", "b"], nul)))
print(encode_json(replace(value, nul, "-")))
print(encode_json(upper(value)))
print(regex_match(value, /b$/))
let target = path("tests/output/string-nul.txt")
write_text(target, value)
print(read_text(target) == value)
remove(target)
let keyed = parse_json("{\"a\\u0000b\": 7}")
print(get(keyed, value))
print(encode_json(put({}, value, 8)))
print(encode_json(remove_key(keyed, value)))
print(keyed == parse_json("{\"a\\u0000b\": 7}"))
print([keyed, [1, 2]] == [parse_json("{\"a\\u0000b\": 7}"), [1, 2]])
let process_result = run(["printf", "a\\0b"])
print(process_result.stdout == value)
let csv_rows = ("name\n" + value) |> parse_csv({ header: true }) |> collect
print(get(get(csv_rows, 0), "name") == value)
let csv_encoded = csv_rows |> stream |> encode_csv({ header: true }) |> collect |> join("\n")
print(csv_encoded == ("name\n" + value))
print((attempt { to_int("") }).ok == false)
print((attempt { to_float(value) }).ok == false)
